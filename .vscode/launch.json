{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "QEMU realview-pb-a8",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": true,
            "setupCommands": [
                {
                    "text": "set tdesc filename ${workspaceFolder}/virtual_device/tdesc.xml",
                    "ignoreFailures": false
                },
                {
                    "text": "set output-radix 16"
                }
            ],
            "preLaunchTask": "QEMU",
            "postDebugTask": "Stop QEMU"
        }
    ]
}